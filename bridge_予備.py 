import serial
import json
import requests
import threading
import time

# ⚙️ COMポートおよびAPIの設定
SERIAL_PORT = 'COM6'  # ESP32中央ユニットが接続されているCOMポート
BAUD_RATE = 115200

MATCH_ID = 1
ROUND_ID = 1

# FastAPIのSwagger UIのエンドポイントURLに完全に一致させる
FASTAPI_URL = f"http://127.0.0.1:8000/api/matches/{MATCH_ID}/rounds/{ROUND_ID}/sensor-data"

# 試合のステータス変数
current_round = 1
is_round_active = False
round_time_left = 45
hp_p1 = 100
hp_p2 = 100

# 🔌 1. ESP32中央ユニットからのESP-NOW受信スレッド
def listen_esp32():
    global hp_p1, hp_p2, is_round_active, current_round
    
    try:
        ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
        print(f"✅ ポート {SERIAL_PORT} を介してESP32中央ユニットに接続しました")
    except Exception as e:
        print(f"❌ ポート {SERIAL_PORT} を開けませんでした: {e}")
        return

    while True:
        if ser.in_waiting > 0:
            line = ser.readline().decode('utf-8', errors='ignore').strip()
            try:
                data = json.loads(line)
                
                # ラウンドがアクティブな時のみパンチを処理する
                if data.get("type") == "punch" and is_round_active:
                    player_id = data.get("playerId", 1)
                    accel = data.get("accelX", 0.0)
                    
                    damage = int(accel / 2) # ダメージ計算式
                    
                    if player_id == 1:
                        hp_p2 = max(0, hp_p2 - damage)
                    elif player_id == 2:
                        hp_p1 = max(0, hp_p1 - damage)

                    payload = {
                        "type": "punch",
                        "round": current_round,
                        "playerId": player_id,
                        "accelX": accel,
                        "hp_p1": hp_p1,
                        "hp_p2": hp_p2,
                        "timeLeft": round_time_left
                    }
                    print(f"🥊 プレイヤー {player_id} のパンチ (威力: {accel:.1f}) | P1 HP: {hp_p1}% | P2 HP: {hp_p2}%")
                    
                    # FastAPIバックエンドへ送信
                    try:
                        requests.post(FASTAPI_URL, json=payload, timeout=0.2)
                    except:
                        pass

            except json.JSONDecodeError:
                pass

# ⏱️ 2. ラウンド残り時間カウントダウンスレッド (45秒)
def timer_thread():
    global round_time_left, is_round_active, current_round
    while True:
        if is_round_active:
            if round_time_left > 0:
                time.sleep(1)
                round_time_left -= 1
                
                # 毎秒、時間の更新をFastAPIへプッシュする
                payload = {
                    "type": "timer",
                    "round": current_round,
                    "timeLeft": round_time_left,
                    "hp_p1": hp_p1,
                    "hp_p2": hp_p2
                }
                try:
                    requests.post(FASTAPI_URL, json=payload, timeout=0.2)
                except:
                    pass
            else:
                # 45秒経過 -> パンチを受け付けなくする
                is_round_active = False
                print(f"\n🔔 ラウンド {current_round} 終了！ ([ENTER]キーを押すと次のラウンドへ進みます)")
                payload = {
                    "type": "round_end",
                    "round": current_round,
                    "reason": "TIMEOUT",
                    "hp_p1": hp_p1,
                    "hp_p2": hp_p2
                }
                try:
                    requests.post(FASTAPI_URL, json=payload, timeout=0.2)
                except:
                    pass
        else:
            time.sleep(0.2)

# バックグラウンドスレッドの起動
threading.Thread(target=listen_esp32, daemon=True).start()
threading.Thread(target=timer_thread, daemon=True).start()

# 🕹️ 3. ラップトップのキーボードコントロールスレッド ([ENTER]キー)
print("==================================================")
print("🚀 審判システムは準備完了です！")
print("👉 ラップトップの [ENTER] キーを押して、開始 / 次のラウンドへ進んでください")
print("==================================================")

while True:
    input() # ユーザーがEnterキーを押すのを待つ
    current_round += 1
    hp_p1 = 100
    hp_p2 = 100
    round_time_left = 45
    is_round_active = True
    
    print(f"\n🔔 ラウンド {current_round} 開始！ (45秒カウントダウン | HP = 100%にリセット)")
    
    # 新しいラウンドの開始をFastAPIに通知する
    payload = {
        "type": "round_start",
        "round": current_round,
        "timeLeft": 45,
        "hp_p1": 100,
        "hp_p2": 100
    }
    try:
        requests.post(FASTAPI_URL, json=payload, timeout=0.2)
    except:
        pass
